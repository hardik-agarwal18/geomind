APP_ENV=development

HTTP_ADDR=:8080
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
MAX_HEADER_BYTES=1048576

LOG_LEVEL=debug

SHUTDOWN_TIMEOUT=10s

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=geomind

# Administrative account
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ADMIN_PASSWORD

# Application account
APP_DB_USER=geomind_app
APP_DB_PASSWORD=CHANGE_APP_PASSWORD

# Migration account
MIGRATION_DB_USER=geomind_migrator
MIGRATION_DB_PASSWORD=CHANGE_MIGRATION_PASSWORD

# Application connection
DATABASE_URL=postgres://geomind_app:CHANGE_APP_PASSWORD@127.0.0.1:5432/geomind?sslmode=disable

# Migration connection
MIGRATION_DATABASE_URL=postgres://geomind_migrator:CHANGE_MIGRATION_PASSWORD@127.0.0.1:5432/geomind?sslmode=disable

# PostgreSQL connection pool

DB_MAX_CONNS=10
DB_MIN_CONNS=0

DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m

DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s